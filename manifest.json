{
  "manifest_version": 3,
  "name": "FloatShield Pro",
  "version": "2.0",
  "description": "Premium floating ad-blocker with a modern glass UI.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["floating.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
